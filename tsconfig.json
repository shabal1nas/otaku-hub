{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "vite-plugin-svgr/client", "node"],
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
